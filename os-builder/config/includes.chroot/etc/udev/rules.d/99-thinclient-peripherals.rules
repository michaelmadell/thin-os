# YubiKey (VID 1050) - Allow non-root access for FIDO2/WebAuthn & USB redirection
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1050", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1050", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Bloomberg Keyboards & Biometric B-Unit (VID 1188) - Grant access to VDI USB daemons
SUBSYSTEM=="usb", ATTRS{idVendor}=="1188", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1188", MODE="0666", GROUP="plugdev"
